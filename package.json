{
  "name": "kitt-reverse-proxy",
  "version": "3.3.1",
  "description": "Local OpenAI-compatible adapter for authorized web chat sessions with UI and network transports.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "bin": {
    "kitt-reverse-proxy": "./dist/cli.js",
    "kitt-agent-gateway": "./dist/gateway/cli.js"
  },
  "scripts": {
    "clean:test": "node -e \"require('node:fs').rmSync('dist-test',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node ./dist/cli.js",
    "dev": "tsx ./src/cli.ts",
    "test": "npm run clean:test && tsc -p tsconfig.json && node --test dist-test/test/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run check && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ]
}
